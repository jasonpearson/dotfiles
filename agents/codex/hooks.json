{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention blocked >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention idle >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ],
        "matcher": "^(startup|resume|clear|fork)$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention done >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention working >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention working >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention idle >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention clear >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
