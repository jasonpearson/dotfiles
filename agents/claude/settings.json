{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {},
  "terminalTitleFromRename": true,
  "permissions": {
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5",
  "skillOverrides": {
    "browser-use": "user-invocable-only",
    "playwright-cli": "user-invocable-only",
    "recommit": "user-invocable-only",
    "web-search": "user-invocable-only"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "default",
  "theme": "dark",
  "editorMode": "vim",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true
}
