{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {},
  "terminalTitleFromRename": true,
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1[1m]",
  "skillOverrides": {
    "agent-browser": "user-invocable-only",
    "playwright-cli": "user-invocable-only",
    "recommit": "user-invocable-only",
    "web-search": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": []
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention working >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": []
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention blocked >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention working >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention working >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention working >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention done >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention clear >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention failed >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention blocked >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise exec -- tmux-attention working >/dev/null 2>&1 || :",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "tui": "default",
  "theme": "dark",
  "editorMode": "vim",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true
}
